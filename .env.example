# Public connection metadata. The publishable key remains constrained by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Elevated server access. Never prefix this secret with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# AI provider credentials. Keep these server-side and leave values empty in Git.
ZAI_API_KEY=
DEEPSEEK_API_KEY=

# Shared access gate for deployed environments. Production fails closed when
# APP_ACCESS_PASSWORD is absent. The username defaults to "studio".
APP_ACCESS_USERNAME=
APP_ACCESS_PASSWORD=

# Optional centralized model overrides; code provides the documented defaults.
ZAI_TEXT_MODEL=
ZAI_VISION_MODEL=
ZAI_OCR_MODEL=
DEEPSEEK_REASONING_MODEL=
DEEPSEEK_WRITING_MODEL=

# Background quick workflow. Required for external scheduler requests.
CRON_SECRET=
# Set to 1 only when another worker/scheduler owns dispatch. Default: enabled.
QUICK_WORKER_DISABLED=

# Public connection metadata. The publishable key remains constrained by RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Elevated server access. Never prefix this secret with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace-with-supabase-server-key

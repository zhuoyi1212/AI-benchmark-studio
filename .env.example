# Public connection metadata. The publishable key remains constrained by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Elevated server access. Never prefix this secret with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# AI provider credentials. Keep these server-side and leave values empty in Git.
ZAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# Administrator gate for deployed environments. Page reads are public; writes,
# APIs and internal pages fail closed when the password is absent in production.
# The username defaults to "studio".
APP_ACCESS_USERNAME=
APP_ACCESS_PASSWORD=

# Optional centralized model overrides; code provides the documented defaults.
ZAI_TEXT_MODEL=
ZAI_VISION_MODEL=
ZAI_OCR_MODEL=
DEEPSEEK_REASONING_MODEL=
DEEPSEEK_WRITING_MODEL=
# Community writing / revision / title. Default: kimi-k3.
MOONSHOT_WRITING_MODEL=

# Background quick workflow. Required for external scheduler requests.
CRON_SECRET=
# Set to 1 only when another worker/scheduler owns dispatch. Default: enabled.
QUICK_WORKER_DISABLED=

# Optional executable overrides for an independent Node media worker.
# Vercel uses the platform binaries installed by the pinned npm packages.
FFMPEG_PATH=
FFPROBE_PATH=

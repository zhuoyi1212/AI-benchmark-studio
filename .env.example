# Public connection metadata. The publishable key remains constrained by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Elevated server access. Never prefix this secret with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# AI provider credentials. Keep these server-side and leave values empty in Git.
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=

# Optional centralized model overrides; code provides the documented defaults.
ZHIPU_TEXT_MODEL=
ZHIPU_VISION_MODEL=
ZHIPU_OCR_MODEL=
DEEPSEEK_REASONING_MODEL=
